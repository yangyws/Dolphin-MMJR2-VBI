    <string name="show_ftimes">顯示幀生成時間 (Frame Times)</string>
    <string name="show_ftimes_description">顯示相鄰畫面幀之間的平均毫秒時間與標準差。</string>
    <string name="show_vps">顯示每秒場次 (VPS)</string>
    <string name="show_vps_description">顯示每秒算繪場數，作為模擬運算速度的衡量指標。</string>
    <string name="show_vtimes">顯示垂直更新間隔時間 (VBlank Times)</string>
    <string name="show_vtimes_description">顯示每個算繪場之間的平均毫秒時間與標準差。</string>
    <string name="show_graphs">顯示效能圖表</string>
    <string name="show_graphs_description">在畫面上即時繪製幀時間圖表與統計資訊，呈現模擬效能波動。</string>
    <string name="show_speed" formatted="false">顯示模擬速度百分比 (%)</string>
    <string name="show_speed_description">顯示相對於原機全速的模擬執行速度百分比。</string>
    <string name="show_speed_colors">依速度切換顏色</string>
    <string name="show_speed_colors_description">根據模擬速度快慢動態改變 FPS 計數器的顏色。</string>
    <string name="enhancements_submenu">畫面增強</string>
    <string name="internal_resolution">內部算繪解析度</string>
    <string name="internal_resolution_description">指定 3D 算繪的內部解析度。高解析度能極大幅度提升畫質細緻度，但對硬體 GPU 負載較大，少數遊戲可能出現畫面瑕疵。</string>
    <string name="FSAA">全景反鋸齒 (FSAA)</string>
    <string name="FSAA_description">平滑消除 3D 物件邊緣的鋸齒狀線條，使畫面更加柔順。此功能會顯著降低運算速度並在部分遊戲引發異常。</string>
    <string name="anisotropic_filtering">非等方性紋理過濾 (Anisotropic Filtering)</string>
    <string name="anisotropic_filtering_description">增強傾斜視角下遠景材質紋理的清晰度。極少數遊戲可能會有些微瑕疵。</string>
    <string name="texture_filtering">紋理過濾模式</string>
    <string name="texture_filtering_description">覆蓋遊戲自訂的紋理縮放濾鏡。除「預設」外之選項可能改變材質外觀。</string>
    <string name="post_processing_shader">後製處理特效 (Post-Processing)</string>
    <string name="post_processing_shader_description">在畫面算繪完成後套用後製著色特效。</string>
    <string name="postprocessing_shader">後製處理著色器</string>
    <string name="postprocessing_shader_description">在單一畫面完成後套用指定的後製著色器效果。</string>
    <string name="scaled_efb_copy">依解析度縮放 EFB 複本 (Scaled EFB Copy)</string>
    <string name="scaled_efb_copy_description">大幅提升使用「算繪至紋理」技術之畫面材質品質。提升內部解析度可增強此效果。極輕微影響效能。</string>
    <string name="per_pixel_lighting">逐像素光照 (Per-Pixel Lighting)</string>
    <string name="per_pixel_lighting_description">以逐像素方式計算 3D 光影而非頂點光照，提供更平滑逼真的光澤。通常安全但會增加少許 GPU 負載。</string>
    <string name="force_texture_filtering">強制紋理過濾</string>
    <string name="force_texture_filtering_description">即使遊戲明示停用仍強制進行紋理過濾。可稍微提升畫質，但可能在某些遊戲產生畫面瑕疵。</string>
    <string name="force_24bit_color">強制 24 位元色彩</string>
    <string name="force_24bit_color_description">強制將 RGB 色彩通道以 24 位元算繪，消除色階斷層與色帶現象。不影響效能且極少出錯，建議保持開啟。</string>
    <string name="disable_fog">停用霧氣效果</string>
    <string name="disable_fog_description">移除畫面霧氣以提高遠景清晰度與細節。依賴正確霧氣模擬的遊戲畫面可能會出現異常。</string>
    <string name="disable_copy_filter">停用複製濾鏡 (Anti-Flicker)</string>
    <string name="disable_copy_filter_description">在複製 EFB 時停用相鄰行混合濾鏡（即抗閃爍消除濾鏡）。停用通常安全且能帶來更銳利的畫面影像。</string>
    <string name="arbitrary_mipmap_detection">任意 Mipmap 偵測</string>
    <string name="arbitrary_mipmap_detection_description">啟用對遊戲自訂距離 Mipmap 紋理的偵測機制。在高解析度下可能誤判導致模糊，若不確定請保持取消勾選。</string>
    <string name="color_correction_submenu">色彩校正</string>
    <string name="color_space">色彩空間 (Color Space)</string>
    <string name="correct_color_space">校正色彩空間</string>
    <string name="correct_color_space_description">將 GameCube/Wii 原生色彩空間正確轉換至現代螢幕標準之 sRGB/Rec.709。</string>
    <string name="game_color_space">遊戲色彩空間標準</string>
    <string name="ntscm_space">NTSC-M (SMPTE 170M)</string>
    <string name="ntscj_space">NTSC-J (ARUB TR-89)</string>
    <string name="pal_space">PAL (EBU)</string>
    <string name="stereoscopy_submenu">立體 3D (Stereoscopy)</string>
    <string name="stereoscopy_submenu_description">搭配支援之硬體（如 3D 螢幕或 VR）體驗身歷其境的景深立體感。會大幅增加效能消耗。</string>
    <string name="wide_screen_hack">寬螢幕黑客補丁 (Widescreen Hack)</string>
    <string name="wide_screen_hack_description">強制遊戲以任意比例輸出畫面。建議配合「長寬比強制 16:9」將原 4:3 遊戲延展為 16:9 寬螢幕。若已使用 Gecko/AR 寬螢幕代碼請勿開啟此選項。</string>
    <string name="stereoscopy_mode">立體 3D 模式</string>
    <string name="stereoscopy_mode_description">選擇立體 3D 顯示模式（如左右並排、紅藍立體等）。</string>
    <string name="stereoscopy_depth">立體景深 (Depth)</string>
    <string name="stereoscopy_depth_description">調整雙眼虛擬攝影機之間的間距。數值越高立體深度感越強烈，較低數值觀看更為舒適。</string>
    <string name="stereoscopy_convergence">聚焦匯聚點 (Convergence)</string>
    <string name="stereoscopy_convergence_description">控制立體聚合平面距離，決定物體躍出螢幕的距離感。</string>
    <string name="stereoscopy_swap_eyes">左右眼視角對調</string>
    <string name="stereoscopy_swap_eyes_description">交換左眼與右眼的成像畫面，適用於交叉鬥雞眼檢視方式。</string>
    <string name="manual_texture_sampling">手動紋理取樣 (Manual Texture Sampling)</string>
    <string name="manual_texture_sampling_description">使用手動演算法實作紋理取樣，而非依賴繪圖後端內建功能。</string>

    <string name="hacks_submenu">黑客效能提速設定 (Hacks)</string>
    <string name="embedded_frame_buffer">嵌入式幀緩衝區 (EFB)</string>
    <string name="skip_efb_access">略過 CPU 存取 EFB</string>
    <string name="skip_efb_access_description">略過所有來自 CPU 讀寫 EFB 的請求。大幅提升遊戲流暢度，但少數需要游標瞄準或特殊畫面讀取的遊戲可能會失效。</string>
    <string name="ignore_format_changes">忽略格式變更</string>
    <string name="ignore_format_changes_description">忽略任何對 EFB 格式進行的變更要求。</string>
    <string name="efb_copy_method">僅將 EFB 複本儲存至紋理 (GPU)</string>
    <string name="efb_copy_method_description">將 EFB 複本完全存放在 GPU 顯示記憶體中，不寫回系統記憶體。極少數遊戲可能出現貼圖異常，建議預設勾選。</string>
    <string name="defer_efb_copies">延遲 EFB 複本寫回記憶體</string>
    <string name="defer_efb_copies_description">等待遊戲與 GPU 同步後再將 EFB 內容寫回系統 RAM，可提升效能。若不確定請保持未勾選。</string>
    <string name="texture_cache">紋理快取</string>
    <string name="texture_cache_accuracy">紋理快取精確度 (Texture Cache Accuracy)</string>
    <string name="texture_cache_accuracy_description">設定等級越高越安全，能避免模擬器遺漏記憶體中的紋理更新；設定為快速可提升速度。</string>
    <string name="gpu_texture_decoding">GPU 紋理解碼</string>
    <string name="gpu_texture_decoding_description">在支援的裝置上使用計算著色器由 GPU 解碼紋理，可在多數場景提升運算效能。</string>
    <string name="external_frame_buffer">外部幀緩衝區 (XFB)</string>
    <string name="xfb_copy_method">僅將 XFB 複本儲存至紋理 (GPU)</string>
    <string name="xfb_copy_method_description">將 XFB 複本單獨存放在 GPU 顯存中。少數需要從記憶體讀回畫面的遊戲可能會出現畫面瑕疵，建議勾選。</string>
    <string name="immediate_xfb">立即呈現 XFB (Immediate XFB)</string>
    <string name="immediate_xfb_description">XFB 複本生成時立即呈現在螢幕上，無需等待掃描線輸出。能大幅降低輸入延遲，但在某些遊戲可能造成畫面撕裂。</string>
    <string name="skip_duplicate_xfbs">略過呈現重複畫面幀</string>
    <string name="skip_duplicate_xfbs_description">跳過重複未變更的畫面格，有助於低階設備提升流暢度，但可能使幀節奏略有不均。建議勾選。</string>
    <string name="fast_depth_calculation">快速深度計算</string>
    <string name="fast_depth_calculation_description">使用近似演算法計算深度值以提升運算速度。少數遊戲可能產生穿透錯誤，建議勾選。</string>
    <string name="disable_bbox">停用邊界框 (Disable Bounding Box)</string>
    <string name="disable_bbox_description">停用邊界框模擬以大幅降低 GPU 負擔。紙片瑪利歐等依賴 BBox 的遊戲需保持關閉，其餘遊戲建議勾選。</string>
    <string name="vertex_rounding">頂點捨入 (Vertex Rounding)</string>
    <string name="vertex_rounding_description">將 2D 頂點與視口尺寸捨入為整數像素。在高內部解析度下可修復部分遊戲的線條瑕疵，原機解析度下無效。</string>
    <string name="vi_skip">VBI 跳幀加速 (VBI Skip)</string>
    <string name="vi_skip_description" formatted="false">【MMJR2 核心特色】偵測到卡頓掉幀時自動跳過垂直消隱 (VI) 中斷，讓遊戲即使未達 100% 速度仍能保持音訊流暢不破音！可能造成少數遊戲凍結。</string>
    <string name="texture_cache_to_state">將紋理快取儲存至即時存檔</string>
    <string name="texture_cache_to_state_description">在即時存檔中包含 EFB 緩衝區與放大材質，能徹底解決讀取存檔時貼圖消失或模糊的問題，但會稍微增加存檔時間。</string>
    <string name="fast_texture_sampling">快速紋理取樣</string>
    <string name="fast_texture_sampling_description">使用圖形 API 原生硬體取樣功能，取代手動軟體取樣實作以增進效能。</string>
    <string name="aspect_ratio">畫面顯示比例 (Aspect Ratio)</string>
    <string name="aspect_ratio_description">設定算繪顯示時的畫面長寬比 (如 自動、4:3、16:9 或 強制填滿)。</string>
    <string name="shader_compilation_mode">著色器編譯模式</string>
    <string name="fast_disc_speed">加速光碟讀取速度</string>
    <string name="fast_disc_speed_description">加速虛擬光碟機讀取速度以顯著縮短載入等待時間。依賴精確讀取時序的遊戲可能出現不穩定或當機。</string>
    <string name="wait_for_shaders">啟動前預先編譯著色器</string>
    <string name="wait_for_shaders_description">在遊戲啟動時先行編譯已知著色器，啟動時需稍候，但能大幅減輕進入遊戲初期的卡頓現象。</string>

    <string name="advanced_graphics_submenu">進階繪圖設定</string>
    <string name="gfx_mods_and_custom_textures">繪圖 Mod 補丁與高解析度材質</string>
    <string name="gfx_mods">啟用繪圖 Mod 補丁</string>
    <string name="gfx_mods_description">從 User/Load/GraphicsMods/ 目錄載入自訂圖形 Mod。</string>
    <string name="load_custom_texture">載入自訂高畫質材質</string>
    <string name="load_custom_texture_description">從 User/Load/Textures/&lt;game_id&gt;/ 與 DynamicInputTextures 載入高解析度材質包。</string>
    <string name="cache_custom_texture">預先讀取材質至記憶體</string>
    <string name="cache_custom_texture_description">啟動時將高解析度材質預載入至系統記憶體，可徹底解決動態讀取卡頓，但需消耗較多 RAM。</string>
    <string name="dump_texture">傾印遊戲紋理 (Dump Textures)</string>
    <string name="dump_texture_description">將解碼後的遊戲材質傾印匯出至 User/Dump/Textures/&lt;game_id&gt;/。非製作材質包請勿勾選。</string>
    <string name="dump_base_texture">傾印基礎紋理</string>
    <string name="dump_base_texture_description">是否將基礎遊戲材質傾印匯出至 Dump 目錄。</string>
    <string name="dump_mip_texture">傾印 Mipmap 紋理</string>
    <string name="dump_mip_texture_description">是否將 Mipmap 層級材質傾印匯出至 Dump 目錄。</string>
    <string name="misc">其他</string>
    <string name="crop">裁切畫面邊緣</string>
    <string name="crop_description">將畫面裁切為標準 4:3 或 16:9 以消除黑邊。若不確定請保持未勾選。</string>
    <string name="progressive_scan">啟用循序掃描 (Progressive Scan)</string>
    <string name="backend_multithreading">後端多執行緒算繪 (Vulkan)</string>
    <string name="backend_multithreading_description">啟用圖形後端的多執行緒算繪（僅限 Vulkan API），能有效發揮多核心效能，建議開啟。</string>
    <string name="prefer_vs_for_point_line_expansion">優先使用頂點著色器擴展點/線</string>
    <string name="prefer_vs_for_point_line_expansion_description">在同時支援幾何著色器與頂點著色器的後端中，選用頂點著色器執行點線擴展，可改善部分硬體效能。</string>
    <string name="cpu_cull">在 CPU 上剔除視錐外頂點</string>
    <string name="cpu_cull_description">由 CPU 事先剔除鏡頭外頂點以減少繪製呼叫 (Draw Calls)。若不確定請保持未勾選。</string>
    <string name="defer_efb_invalidation">延遲 EFB 快取失效</string>
    <string name="defer_efb_invalidation_description">延遲使 EFB 快取失效直至執行 GPU 同步指令，在部分遊戲中可提升效能但可能影響穩定性。</string>
    <string name="internal_resolution_dumps">以內部解析度傾印畫面</string>
    <string name="internal_resolution_dumps_description">以模擬算繪的內部高解析度擷取螢幕畫面，而非目前的視窗尺寸。</string>
    <string name="debugging">除錯選項</string>
//    <string name="wireframe">啟用線框</string>
    <string name="show_stats">顯示統計資訊</string>
//    <string name="texture_format">材質格式疊加顯示</string>
    <string name="validation_layer">啟用 API 驗證層 (Validation Layers)</string>
    <string name="dump_efb">傾印 EFB 目標</string>
    <string name="dump_xfb">傾印 XFB 目標</string>
    <string name="disable_vram_copies">停用 EFB 顯存複本</string>
    <string name="leave_this_unchecked">若不確定，請保持未勾選。</string>

